# ------------------------------------------------------------------
# HTML2APK Studio — example environment file
# Copy to .env and adjust for your machine. All values below are
# placeholders; the app falls back to sane defaults when unset.
# ------------------------------------------------------------------

# --- Database (Prisma + SQLite) ---
DATABASE_URL="file:./db/custom.db"

# --- Build toolchain (optional; defaults resolve inside the project) ---
# H2A_ANDROID_SDK=/absolute/path/to/android-sdk
# H2A_JAVA_HOME=/absolute/path/to/jdk-21
# H2A_GRADLE_BIN=/absolute/path/to/gradle-8.11.1/bin/gradle
# H2A_GRADLE_HOME=/absolute/path/to/gradle-8.11.1
# H2A_GRADLE_USER_HOME=/absolute/path/to/.gradle-home
H2A_BUILD_TOOLS=36.0.0
H2A_MAVEN_MIRROR=aliyun

# --- Storage layout (optional) ---
# H2A_ROOT=/absolute/path/to/project
# H2A_STORAGE_DIR=/absolute/path/to/storage

# --- Build queue tuning ---
H2A_MAX_CONCURRENT_BUILDS=1
H2A_BUILD_TIMEOUT_MIN=25
H2A_RETENTION_DAYS=7

# --- First-run seeding ---
# Password for the auto-created admin account (admin@html2apk.studio)
# H2A_SEED_ADMIN_PASSWORD=change-me
# Set to true to also seed the demo account in production mode
# H2A_SEED_DEMO=true

# --- Runtime ---
NODE_ENV=development
